<!doctype html>
<html lang="fa-IR">
<%- include('landing-data') %>
<head>
    <meta name="enamad" content="305506"/>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, viewport-fit=cover, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title><%- LANDING_BROWSER_TITLE %></title>
    <meta name="description"
          content="<%- LANDING_META.description %>">
    <meta name="keywords"
          content="<%- LANDING_META.keywords %>">
    <meta name="robots" content="<%- LANDING_META.robots %>">
    <link rel="canonical" href="<%- LANDING_META.siteUrl %>">

    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="<%- LANDING_APP_NAME %>"/>
    <meta property="og:locale" content="<%- LANDING_META.locale %>"/>
    <meta property="og:title" content="<%- LANDING_TITLE %>"/>
    <meta property="og:description"
          content="<%- LANDING_META.description %>"/>
    <meta property="og:url" content="<%- LANDING_META.siteUrl %>"/>
    <meta property="og:image" content="<%- LANDING_META.siteUrl %><%- LANDING_META.imagePath.replace(/^\//, '') %>?v=<%- VERSION %>"/>
    <meta property="og:image:secure_url" content="<%- LANDING_META.siteUrl %><%- LANDING_META.imagePath.replace(/^\//, '') %>?v=<%- VERSION %>"/>
    <meta property="og:image:type" content="<%- LANDING_SHARE_IMAGE.type %>"/>
    <meta property="og:image:width" content="<%- LANDING_SHARE_IMAGE.width %>"/>
    <meta property="og:image:height" content="<%- LANDING_SHARE_IMAGE.height %>"/>
    <meta property="og:image:alt" content="<%- LANDING_SHARE_IMAGE.alt %>"/>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%- VERSION %>">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=<%- VERSION %>">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=<%- VERSION %>">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=<%- VERSION %>">
    <link rel="shortcut icon" href="/favicon.ico?v=<%- VERSION %>">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=<%- VERSION %>">
    <link rel="manifest" href="/site.webmanifest?v=<%- VERSION %>">
    <link rel="mask-icon" href="/safari-pinned-tab.svg?v=<%- VERSION %>" color="<%- LANDING_META.themeColor %>">
    <meta name="apple-mobile-web-app-title" content="<%- LANDING_APP_NAME %>">
    <meta name="msapplication-TileColor" content="<%- LANDING_META.themeColor %>">
    <meta name="theme-color" content="<%- LANDING_META.themeColor %>">

    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/0.97.6/css/materialize.min.css">
    <link rel="stylesheet" href="assets/css/style.css?v=<%- VERSION %>">

    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-102933584-6"></script>
    <script>
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }

        gtag('js', new Date());

        gtag('config', 'UA-102933584-6');
        gtag('config', 'AW-782563262');
    </script>
    <!-- Event snippet for Check Landing Page conversion page
  In your html page, add the snippet and call gtag_report_conversion when someone clicks on the chosen link or button. -->
    <script>
        function gtag_report_conversion(url) {
            var callback = function () {
                if (typeof (url) != 'undefined') {
                    window.location = url;
                }
            };
            gtag('event', 'conversion', {
                'send_to': 'AW-782563262/4-lVCPTT0IsBEL7vk_UC',
                'event_callback': callback
            });
            return false;
        }
    </script>
    <script type="application/ld+json">
<%- JSON.stringify(LANDING_SCHEMA, null, 8) %>
    </script>

</head>

<body>
<%- include('parts/header') %>
<%- include('parts/main') %>
<%- include('parts/footer') %>
<script src="/chat-config.js?v=<%- VERSION %>"></script>
<script>
    window.KALAMATIC_CHAT_PAGE = 'landing';
</script>
<script src="assets/js/chat-widget.js?v=<%- VERSION %>"></script>
<script src="assets/js/screenshot-gallery.js?v=<%- VERSION %>"></script>
</body>

</html>
