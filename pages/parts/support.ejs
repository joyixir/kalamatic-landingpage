<% if (SUPPORT_SECTION.enabled) { %>
    <% 
        const faqPreviewCount = FAQ_SECTION.faqPreviewCount || 3;
        const visibleFaqs = FAQ_SECTION.faqs.slice(0, faqPreviewCount);
        const hiddenFaqs = FAQ_SECTION.faqs.slice(faqPreviewCount);
    %>
    <section class="support-section" id="<%- SUPPORT_SECTION.sectionId %>">
        <div class="support-grid">
            <article class="support-card support-card--faq" id="support-faq">
                <h3 class="support-card-title"><%- FAQ_SECTION.faqTitle %></h3>
                <div class="support-faq-list">
                    <% visibleFaqs.forEach(function (faq) { %>
                        <details class="support-faq-item">
                            <summary class="support-faq-question"><%- faq.question %></summary>
                            <p class="support-faq-answer"><%- faq.answer %></p>
                        </details>
                    <% }) %>
                    <% if (hiddenFaqs.length > 0) { %>
                        <details class="support-faq-more">
                            <summary class="support-faq-more-toggle">
                                <span class="support-faq-more-label support-faq-more-label--closed"><%- FAQ_SECTION.faqExpandLabel %></span>
                                <span class="support-faq-more-label support-faq-more-label--open"><%- FAQ_SECTION.faqCollapseLabel %></span>
                            </summary>
                            <div class="support-faq-more-list">
                                <% hiddenFaqs.forEach(function (faq) { %>
                                    <details class="support-faq-item">
                                        <summary class="support-faq-question"><%- faq.question %></summary>
                                        <p class="support-faq-answer"><%- faq.answer %></p>
                                    </details>
                                <% }) %>
                            </div>
                        </details>
                    <% } %>
                </div>
            </article>

            <article class="support-card support-card--contact" id="support-contact">
                <h3 class="support-card-title"><%- SUPPORT_SECTION.contactTitle %></h3>
                <p class="support-card-body"><%- SUPPORT_SECTION.contactBody %></p>
                <div class="support-actions">
                    <% if (SUPPORT_SECTION.chatAction) { %>
                        <a class="support-action support-action--chat support-chat-trigger" href="<%- SUPPORT_SECTION.chatAction.href %>" data-chat-trigger data-chat-direct<% if (!LANDING_CHAT_ENABLED) { %> hidden<% } %>>
                            <%- SUPPORT_SECTION.chatAction.label %>
                        </a>
                    <% } %>
                    <a class="support-action support-action--primary" href="<%- SUPPORT_SECTION.contactLink.href %>"<% if (SUPPORT_SECTION.contactLink.target) { %> target="<%- SUPPORT_SECTION.contactLink.target %>"<% } %><% if (SUPPORT_SECTION.contactLink.rel) { %> rel="<%- SUPPORT_SECTION.contactLink.rel %>"<% } %>>
                        <%- SUPPORT_SECTION.contactLink.label %>
                    </a>
                    <a class="support-action support-action--secondary" href="<%- SUPPORT_SECTION.emailLink.href %>">
                        <%- SUPPORT_SECTION.emailLink.label %>
                    </a>
                </div>
            </article>
        </div>
    </section>
<% } %>
