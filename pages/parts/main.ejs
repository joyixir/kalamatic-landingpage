<main class="landing-main">
    <div class="container">
        <section class="hero-layout" itemscope itemtype="https://schema.org/MobileApplication">
            <article class="hero-intro-card">
                <div class="hero-intro-brand">
                    <img src="<%- HERO_SECTION.icon.src %>?v=<%- HERO_SECTION.icon.version %>" alt="<%- HERO_SECTION.icon.alt %>"
                         class="hero-intro-icon" width="<%- HERO_SECTION.icon.width %>" height="<%- HERO_SECTION.icon.height %>" decoding="async" fetchpriority="high">
                    <h1 class="hero-intro-title"><%- HERO_SECTION.title %></h1>
                </div>
            </article>

            <section class="description-section" id="<%- DESCRIPTION_SECTION.sectionId %>">
                <div class="description-section-inner">
                    <div class="hero-content">
                        <div class="hero-copy">
                            <p class="body">
                                <%- DESCRIPTION_SECTION.intro %>
                                <% DESCRIPTION_SECTION.features.forEach(function (feature) { %>
                                    <br>🔹 <%- feature %>
                                <% }) %>
                                <br><br><%- DESCRIPTION_SECTION.outro %>
                            </p>
                        </div>

                        <div class="hero-visual">
                            <div class="screenshot">
                                <img src="<%- DESCRIPTION_SECTION.mockup.src %>?v=<%- DESCRIPTION_SECTION.mockup.version %>"
                                     alt="<%- DESCRIPTION_SECTION.mockup.alt %>" width="<%- DESCRIPTION_SECTION.mockup.width %>" height="<%- DESCRIPTION_SECTION.mockup.height %>"
                                     loading="lazy" decoding="async" fetchpriority="low">
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </section>

        <section class="download-section" id="<%- DOWNLOAD_SECTION.sectionId %>">
            <div class="download-section-inner">
                <h2 class="download-section-title"><%- DOWNLOAD_SECTION.title %></h2>
                <div class="download-btns download-btns--card">
                    <% DOWNLOAD_SECTION.buttons.forEach(function (button) { %>
                        <a href="<%- button.href %>"
                           onclick="gtag_report_conversion('<%- button.href %>')">
                            <img src="<%- button.imageSrc %>?v=<%- button.imageVersion %>"
                                 alt="<%- button.alt %>" width="<%- button.width %>" height="<%- button.height %>"
                                 decoding="async">
                        </a>
                    <% }) %>
                </div>
            </div>
        </section>

        <%- include('screenshots') %>
        <%- include('support') %>
    </div>
</main>
