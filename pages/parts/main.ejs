<main class="landing-main">
    <div class="container">
        <section class="hero-layout" itemscope itemtype="https://schema.org/MobileApplication">
            <div class="hero-copy">
                <div class="hero-brand">
                    <img src="<%- LANDING_ASSETS.icon.src %>?v=<%- LANDING_ASSETS.icon.version %>" alt="<%- LANDING_ASSETS.icon.alt %>"
                         class="icon" width="<%- LANDING_ASSETS.icon.width %>" height="<%- LANDING_ASSETS.icon.height %>" decoding="async" fetchpriority="high">
                    <div class="heading">
                        <h1 class="title"><%- LANDING_CONTENT.heroTitle %></h1>
                    </div>
                </div>

                <p class="body">
                    <%- LANDING_CONTENT.bodyIntro %>
                    <% LANDING_CONTENT.bodyFeatures.forEach(function (feature) { %>
                        <br>🔹 <%- feature %>
                    <% }) %>
                    <br><br><%- LANDING_CONTENT.bodyOutro %>
                </p>

                <!-- Primary download buttons live here; their shared badge assets are in src/img/store-badges/. -->
                <div class="download-btns">
                    <% LANDING_DOWNLOADS.buttons.forEach(function (button) { %>
                        <a href="<%- button.href %>"
                           onclick="gtag_report_conversion('<%- button.href %>')">
                            <img src="<%- button.imageSrc %>?v=<%- button.imageVersion %>"
                                 alt="<%- button.alt %>" width="<%- button.width %>" height="<%- button.height %>"
                                 decoding="async">
                        </a>
                    <% }) %>
                </div>
            </div>

            <div class="hero-visual">
                <div class="screenshot">
                    <img src="<%- LANDING_ASSETS.screenshot.src %>?v=<%- LANDING_ASSETS.screenshot.version %>"
                         alt="<%- LANDING_ASSETS.screenshot.alt %>" width="<%- LANDING_ASSETS.screenshot.width %>" height="<%- LANDING_ASSETS.screenshot.height %>"
                         loading="lazy" decoding="async" fetchpriority="low">
                </div>
            </div>
        </section>

        <%- include('support') %>
    </div>
</main>
