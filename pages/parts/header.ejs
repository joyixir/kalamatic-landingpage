<header class="navbar-fixed site-header">
    <nav class="site-nav">
        <div class="container site-nav-inner">
            <ul class="header-socials">
                <% HEADER_SECTION.actions.forEach(function (action) { %>
                    <li>
                        <a href="<%- action.href %>"
                           class="header-social-link" aria-label="<%- action.label %>"<% if (action.target) { %> target="<%- action.target %>"<% } %><% if (action.rel) { %> rel="<%- action.rel %>"<% } %><% if (action.chatTrigger) { %> data-chat-trigger<% } %><% if (action.chatDirect) { %> data-chat-direct<% } %><% if (action.chatDirect && !LANDING_CHAT_ENABLED) { %> hidden<% } %>>
                            <img class="header-social-image" src="<%- action.imageSrc %>" alt="" loading="lazy" decoding="async">
                        </a>
                    </li>
                <% }) %>
            </ul>
            <span class="header-brand-text"><%- HEADER_SECTION.title %></span>
        </div>
    </nav>
</header>
