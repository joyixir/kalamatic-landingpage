<section class="screenshots-section" id="<%- SCREENSHOTS_SECTION.sectionId %>">
    <div class="screenshots-section-inner">
        <h2 class="screenshots-section-title"><%- SCREENSHOTS_SECTION.title %></h2>
        <div class="screenshots-gallery">
            <% SCREENSHOTS_SECTION.items.forEach(function (shot, index) { %>
                <figure class="screenshot-card">
                    <button class="screenshot-card-button"
                            type="button"
                            data-screenshot-trigger
                            data-screenshot-index="<%- index %>"
                            data-screenshot-src="<%- shot.src %>?v=<%- shot.version %>"
                            data-screenshot-alt="<%- shot.alt %>">
                        <img src="<%- shot.src %>?v=<%- shot.version %>"
                             alt="<%- shot.alt %>"
                             width="<%- shot.width %>"
                             height="<%- shot.height %>"
                             loading="lazy"
                             decoding="async">
                    </button>
                </figure>
            <% }) %>
        </div>
    </div>
    <div class="screenshots-lightbox" data-screenshot-lightbox hidden>
        <div class="screenshots-lightbox-backdrop"></div>
        <div class="screenshots-lightbox-dialog" role="dialog" aria-modal="true" aria-label="<%- SCREENSHOTS_SECTION.title %>">
            <button class="screenshots-lightbox-close" type="button" data-screenshot-close aria-label="<%- SCREENSHOTS_SECTION.closeLabel %>"></button>
            <button class="screenshots-lightbox-nav screenshots-lightbox-nav--prev" type="button" data-screenshot-prev aria-label="<%- SCREENSHOTS_SECTION.previousLabel %>"></button>
            <div class="screenshots-lightbox-frame">
                <img class="screenshots-lightbox-image" src="" alt="" data-screenshot-active-image>
            </div>
            <button class="screenshots-lightbox-nav screenshots-lightbox-nav--next" type="button" data-screenshot-next aria-label="<%- SCREENSHOTS_SECTION.nextLabel %>"></button>
        </div>
    </div>
</section>
